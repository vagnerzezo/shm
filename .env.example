# Copie para .env (ou .env.local) e preencha. Nunca versione o arquivo com os valores.

# E-mails com acesso ao painel admin (separados por vírgula).
ADMIN_EMAILS=

# Resend (https://resend.com): chave da API, começa com re_
RESEND_API_KEY=
# Remetente. Precisa ser de um domínio verificado no Resend.
# Para testar sem domínio: "Studio Heitor Macks <onboarding@resend.dev>" (só envia para o dono da conta).
MARKETING_EMAIL_FROM="Studio Heitor Macks <contato@seu-dominio.com.br>"
# Endereço público do site, usado nos links dos e-mails.
APP_URL=http://localhost:3000

# Protege POST /api/marketing/executar (cron externo): Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
