{
  "name": "shm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --env-file=.env.test --test --test-concurrency=1 tests/*.test.ts",
    "test:migrate": "node --env-file=.env.test node_modules/drizzle-kit/bin.cjs migrate",
    "test:reset": "tsx --env-file=.env.test scripts/test-reset.ts",
    "test:server": "sh scripts/test-server.sh",
    "test:api": "pnpm run test:reset && node tests/api/build-collection.mjs && postman collection run tests/api/shm-api-v1.postman_collection.json -e tests/api/local.postman_environment.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "16.3.6",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
