              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "let json; try { json = pm.response.json(); } catch { json = undefined; }",
                  "pm.test(\"devolve token, validade e usuário\", () => { pm.expect(json.token).to.be.a(\"string\").with.length.above(20); pm.expect(json.expiresAt).to.be.a(\"number\"); pm.expect(json.user.email).to.eql(\"cliente@shm.test\"); pm.expect(json.user).to.not.have.property(\"passwordHash\"); });",
                  "pm.collectionVariables.set(\"clientToken\", json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"cliente@shm.test\",\"password\":\"Teste#12345\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
